-- ==========================================
-- NEX Language v1.1 - Hello World
-- Run: nex hello.N
-- ==========================================

name = "NEX Language"
version = 1.1

[>= "=========================================="]
[>= "  Welcome to " + name]
[>= "  Version: " + version]
[>= "=========================================="]

-- Variables demo
x = 10
y = 20
[>= x + " + " + y + " = " + (x + y)]

-- String operations
text = "hello world"
[>= "Upper: " + upper(text)]
[>= "Lower: " + lower("NEX")]
[>= "Split: " + split(text)]

-- List demo
items = ["N", "E", "X"]
[>= "Items: " + items]
[>= "Count: " + len(items)]

-- Condition demo
score = 85
? score >= 80
    [>= "Grade: A (Excellent!)"]
:? score >= 70
    [>= "Grade: B (Good)"]
:
    [>= "Grade: C (Pass)"]
end

-- Loop demo
[>= "--- Counting 1 to 5 ---"]
@ i in range(1, 6)
    [>= "Count: " + i]
end

-- Function demo
fn greet(user)
    -> "Hello, " + user + "! Welcome to NEX."
end

[>= greet("Developer")]

-- File write demo
<เปิด "hello_output.txt">> "This file was created by NEX Language v1.1" end:
[>= "Created hello_output.txt"]

[>= "=========================================="]
[>= "  Thank you for using NEX Language!"]
[>= "=========================================="]
