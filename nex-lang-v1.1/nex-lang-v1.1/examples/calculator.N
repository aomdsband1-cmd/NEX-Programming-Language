-- ==========================================
-- NEX Language - Simple Calculator
-- ==========================================

fn calc(a, op, b)
    ? op == "+"
        -> a + b
    :? op == "-"
        -> a - b
    :? op == "*"
        -> a * b
    :? op == "/"
        ? b == 0
            [>= "Error: Divide by zero"]
            -> null
        end
        -> a / b
    :? op == "%"
        -> a % b
    :
        [>= "Unknown operator: " + op]
        -> null
    end
end

[>= "10 + 5 = " + calc(10, "+", 5)]
[>= "20 - 8 = " + calc(20, "-", 8)]
[>= "6 * 7 = " + calc(6, "*", 7)]
[>= "100 / 4 = " + calc(100, "/", 4)]
[>= "17 % 5 = " + calc(17, "%", 5)]
[>= "10 / 0 = " + calc(10, "/", 0)]
