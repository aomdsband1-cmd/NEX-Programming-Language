-- ==========================================
-- NEX Language - FizzBuzz
-- ==========================================

fn fizzbuzz(n)
    ? n % 15 == 0
        -> "FizzBuzz"
    :? n % 3 == 0
        -> "Fizz"
    :? n % 5 == 0
        -> "Buzz"
    :
        -> n
    end
end

[>= "=== FizzBuzz 1-20 ==="]
@ i in range(1, 21)
    [>= fizzbuzz(i)]
end
